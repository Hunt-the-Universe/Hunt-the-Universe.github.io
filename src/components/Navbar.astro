---
import NavButton, { type NavButtonTone } from "./NavButton.astro";

export interface NavItem {
  label: string;
  href: string;
  tone?: NavButtonTone;
}

interface Props {
  items?: NavItem[];
  ariaLabel?: string;
  currentHref?: string;
}

const defaultItems: NavItem[] = [
  { label: "Home", href: "/", tone: "pink" },
  { label: "Details + Rules", href: "/rules", tone: "blue" },
  { label: "Register", href: "/register", tone: "yellow" },
  { label: "Tips", href: "/tips", tone: "mint" },
  { label: "Who we are", href: "/who", tone: "peach" },
  { label: "Clue list", href: "/clues", tone: "blue" },
  { label: "Partner with us", href: "/partner", tone: "pink" },
];

const normalizedPath =
  Astro.url.pathname.length > 1
    ? Astro.url.pathname.replace(/\/$/, "")
    : Astro.url.pathname;
const {
  items = defaultItems,
  ariaLabel = "Main navigation",
  currentHref = normalizedPath,
} = Astro.props;
---

<nav class="nav-shell" aria-label={ariaLabel}>
  <ul class="nav-list">
    {
      items.map((item) => (
        <li>
          <NavButton
            href={item.href}
            tone={item.tone ?? "pink"}
            current={item.href === currentHref}
          >
            {item.label}
          </NavButton>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .nav-shell {
    width: min(100%, 82rem);
    margin-inline: auto;
  }

  .nav-list {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 0;
    padding: 0.25rem 0.3rem 0.6rem;
    list-style: none;
  }

  .nav-list li {
    min-width: 0;
  }

  .nav-list :global(.nav-button) {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 64rem) {
    .nav-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .nav-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
      padding: 0.4rem 0.4rem 1rem;
    }
  }
</style>
