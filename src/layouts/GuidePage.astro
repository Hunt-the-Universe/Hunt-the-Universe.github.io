---
import bridgeLeft from "../images/bridge-left.png";
import bridgeRight from "../images/bridge-right.png";
import magnifyingGlass from "../images/magnifying-glass.png";
import rocket from "../images/rocket.png";
import PageLayout from "./PageLayout.astro";

interface Props {
  title: string;
  description: string;
  variant?: "default" | "announcement";
}

const { title, description, variant = "default" } = Astro.props;
---

<PageLayout title={title} description={description}>
    <section class="guide-hero" aria-labelledby="page-title">
        <div class="hero-copy">
            <h1 id="page-title">{title}</h1>
            <p class="dek">{description}</p>
        </div>

        <img
            class="rocket"
            src={rocket.src}
            alt=""
            width={rocket.width}
            height={rocket.height}
        />
    </section>

    <article
        class:list={[
            "guide-sheet",
            variant === "announcement" && "guide-sheet--announcement",
        ]}
    >
        <div class="tape tape--left" aria-hidden="true"></div>
        <div class="tape tape--right" aria-hidden="true"></div>
        <div class="guide-content">
            <slot />
        </div>
    </article>

    <aside class="questions" aria-label="Questions">
        <img
            src={magnifyingGlass.src}
            alt="A smiling magnifying glass"
            width={magnifyingGlass.width}
            height={magnifyingGlass.height}
            loading="lazy"
        />
        <p>
            Tiny question? Giant mystery?
            <br />
            <a href="mailto:HuntTheUniverse@gmail.com">Ask the Hunt Masters!</a>
        </p>
    </aside>

    <img
        class="bridge bridge--left"
        src={bridgeLeft.src}
        alt=""
        width={bridgeLeft.width}
        height={bridgeLeft.height}
        loading="lazy"
    />
    <img
        class="bridge bridge--right"
        src={bridgeRight.src}
        alt=""
        width={bridgeRight.width}
        height={bridgeRight.height}
        loading="lazy"
    />
</PageLayout>

<style>
    .guide-hero {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: minmax(0, 1fr) clamp(7rem, 11vw, 9.5rem);
        width: min(calc(100% - 1rem), 76rem);
        min-height: 14rem;
        align-items: center;
        gap: 2rem;
        margin: clamp(1.5rem, 4vw, 4rem) auto 3.5rem;
        padding: clamp(1rem, 3vw, 4.5rem);
        border: 4px solid var(--color-ink);
        border-radius: 2rem;
        background:
            radial-gradient(
                circle at 80% 14%,
                rgb(255 255 255 / 64%),
                transparent 22%
            ),
            var(--color-yellow);
        box-shadow: 8px 10px 0 rgb(23 33 68 / 22%);
        transform: rotate(-0.45deg);
    }

    .hero-copy {
        position: relative;
        z-index: 2;
    }

    h1 {
        margin: 0;
        color: var(--color-violet);
        font-family: var(--font-hand);
        font-size: clamp(2.75rem, 5.5vw, 4.75rem);
        font-weight: 900;
        letter-spacing: -0.065em;
        line-height: 0.82;
        text-wrap: balance;
        text-transform: uppercase;
    }

    .dek {
        max-width: 40rem;
        margin: 1.35rem 0 0;
        color: var(--color-blue);
        font-family: var(--font-hand);
        font-size: clamp(1.1rem, 2vw, 1.45rem);
        font-weight: 900;
        line-height: 1.35;
    }

    .rocket {
        position: relative;
        z-index: 2;
        display: block;
        width: 100%;
        height: auto;
        justify-self: end;
        filter: drop-shadow(4px 6px 0 rgb(23 33 68 / 16%));
        transform: rotate(6deg);
    }

    .guide-sheet {
        position: relative;
        z-index: 2;
        width: min(calc(100% - 1rem), 76rem);
        margin-inline: auto;
        padding: clamp(1.5rem, 5vw, 4rem);
        border: 3px solid var(--color-ink);
        border-radius: 1.25rem 2.25rem 1.4rem 2rem;
        background:
            linear-gradient(rgb(22 37 216 / 7%) 1px, transparent 1px),
            rgb(255 255 255 / 94%);
        background-size: 100% 2rem;
        box-shadow: 7px 9px 0 rgb(23 33 68 / 20%);
    }

    .tape {
        position: absolute;
        top: -1.4rem;
        width: clamp(6rem, 13vw, 10rem);
        height: 2.8rem;
        background: rgb(169 231 255 / 88%);
        opacity: 0.92;
    }

    .tape--left {
        left: 7%;
        transform: rotate(-4deg);
    }

    .tape--right {
        right: 6%;
        background: rgb(253 3 182 / 35%);
        transform: rotate(5deg);
    }

    .guide-content :global(h2) {
        position: relative;
        margin: 1rem 0 2.25rem;
        padding: clamp(1.2rem, 3vw, 2rem);
        border: 3px solid var(--color-ink);
        border-radius: 1.3rem;
        background: var(--color-blue-soft);
        box-shadow: 5px 6px 0 var(--color-ink);
        color: var(--color-blue);
        font-family: var(--font-hand);
        font-size: clamp(1.8rem, 3.5vw, 2.75rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 0.95;
        text-wrap: balance;
        text-transform: uppercase;
        transform: rotate(0.5deg);
    }

    .guide-content :global(h2:not(:first-child)) {
        margin-top: clamp(4rem, 8vw, 7rem);
        background: var(--color-pink-soft);
        color: var(--color-violet);
        transform: rotate(-0.5deg);
    }

    .guide-content :global(h3) {
        width: fit-content;
        margin: 2.75rem 0 1.2rem -0.6rem;
        padding: 0.55rem 1rem 0.45rem;
        background: var(--color-yellow);
        color: var(--color-pink);
        font-family: var(--font-hand);
        font-size: clamp(1.2rem, 2.25vw, 1.65rem);
        font-weight: 900;
        line-height: 1;
        text-transform: uppercase;
        transform: rotate(-1deg);
    }

    .guide-content :global(p),
    .guide-content :global(li) {
        font-size: clamp(1rem, 1.45vw, 1.13rem);
        line-height: 1.65;
    }

    .guide-content :global(p) {
        margin: 1rem 0;
    }

    .guide-content :global(ol) {
        display: grid;
        gap: 1rem;
        margin: 0;
        padding-left: clamp(1.8rem, 4vw, 2.5rem);
        list-style-type: decimal;
        list-style-position: outside;
    }

    .guide-content :global(ol > li) {
        padding: 0.2rem 0 0.45rem 0.2rem;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
    }

    .guide-content :global(ol > li::marker) {
        color: var(--color-pink);
        font-family: var(--font-hand);
        font-size: 1.25em;
        font-weight: 900;
    }

    .guide-content :global(ul) {
        margin: 0.75rem 0 0;
        padding-left: clamp(1.1rem, 4vw, 2.2rem);
    }

    .guide-content :global(ul li) {
        margin-block: 0.5rem;
    }

    .guide-content :global(ul li::marker) {
        color: var(--color-blue);
        content: "✦  ";
    }

    .guide-content :global(strong) {
        color: var(--color-violet);
        font-family: var(--font-hand);
        font-size: 1.08em;
        font-weight: 900;
    }

    .guide-sheet--announcement {
        width: min(calc(100% - 1rem), 56rem);
        padding: clamp(2.75rem, 7vw, 5.5rem) clamp(1.5rem, 6vw, 4.5rem);
        background:
            radial-gradient(
                circle at 14% 18%,
                rgb(253 3 182 / 10%),
                transparent 24%
            ),
            radial-gradient(
                circle at 88% 80%,
                rgb(22 37 216 / 10%),
                transparent 27%
            ),
            linear-gradient(rgb(22 37 216 / 7%) 1px, transparent 1px),
            rgb(255 255 255 / 96%);
        background-size: auto, auto, 100% 2rem, auto;
        transform: rotate(0.35deg);
    }

    .guide-sheet--announcement .guide-content {
        max-width: 44rem;
        margin-inline: auto;
        text-align: center;
    }

    .guide-sheet--announcement .guide-content :global(p) {
        margin: 0;
        color: var(--color-blue);
        font-family: var(--font-hand);
        font-size: clamp(1.65rem, 4vw, 2.75rem);
        font-weight: 900;
        letter-spacing: -0.035em;
        line-height: 1.2;
        text-wrap: balance;
        text-transform: uppercase;
    }

    .guide-sheet--announcement .guide-content :global(strong) {
        display: inline;
        color: var(--color-pink);
        font-size: 1em;
    }

    .guide-content :global(a),
    .questions a {
        color: var(--color-blue);
        font-weight: 900;
        text-decoration-color: var(--color-pink);
        text-decoration-thickness: 0.14em;
        text-underline-offset: 0.16em;
    }

    .guide-content :global(a:hover),
    .questions a:hover {
        color: var(--color-pink);
    }

    .guide-content :global(a:focus-visible),
    .questions a:focus-visible {
        outline: 3px solid var(--color-pink);
        outline-offset: 3px;
    }

    .questions {
        position: relative;
        z-index: 2;
        display: flex;
        width: min(calc(100% - 2rem), 42rem);
        align-items: center;
        gap: 1rem;
        margin: 2rem auto 0;
        padding: 1rem 1.4rem;
        border: 3px dashed var(--color-blue);
        border-radius: 1.4rem;
        background: rgb(255 255 255 / 78%);
        color: var(--color-ink);
        font-family: var(--font-hand);
        font-size: clamp(1rem, 2vw, 1.25rem);
        font-weight: 900;
        transform: rotate(0.6deg);
    }

    .questions img {
        width: clamp(4.5rem, 10vw, 6.5rem);
        height: auto;
    }

    .questions p {
        margin: 0;
        line-height: 1.35;
    }

    .bridge {
        position: absolute;
        z-index: 1;
        bottom: 0;
        display: block;
        width: clamp(9rem, 20vw, 17rem);
        height: auto;
        pointer-events: none;
        user-select: none;
    }

    .bridge--left {
        left: 0;
    }

    .bridge--right {
        right: 0;
    }

    @media (max-width: 48rem) {
        .guide-hero {
            grid-template-columns: 1fr;
            min-height: 22rem;
            align-items: start;
            margin-top: 2rem;
            padding: 2rem 1.4rem 7rem;
        }

        h1 {
            max-width: 9ch;
            font-size: clamp(2.7rem, 13vw, 4rem);
        }

        .rocket {
            position: absolute;
            right: 1.2rem;
            bottom: 1.2rem;
            width: 5.5rem;
            transform: rotate(6deg);
        }

        .guide-sheet {
            width: 100%;
            padding: 2.4rem 1rem 1.5rem;
        }

        .guide-sheet--announcement {
            padding: 3.25rem 1.25rem;
        }

        .guide-content :global(h2) {
            margin-bottom: 1.75rem;
            padding: 1.2rem 1rem;
            font-size: clamp(1.65rem, 8.5vw, 2.35rem);
        }

        .guide-content :global(h3) {
            margin-left: 0;
        }

        .questions {
            width: calc(100% - 1rem);
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .rocket {
            animation: hover 3.4s ease-in-out infinite;
        }
    }

    @keyframes hover {
        0%,
        100% {
            translate: 0 0;
        }

        50% {
            translate: 0 -0.5rem;
        }
    }
</style>
