---
import bridgeLeft from "../images/bridge-left.png";
import bridgeRight from "../images/bridge-right.png";
import magnifyingGlass from "../images/magnifying-glass.png";
import PageLayout from "../layouts/PageLayout.astro";

const partnershipUrl = "https://forms.gle/LjyxENKB7V2exuue9";
---

<PageLayout
    title="Partner with us"
    description="Partner with Hunt the Universe and help make the event happen."
>
    <section class="partnership-card" aria-labelledby="form-heading">
        <div class="tape tape--left" aria-hidden="true"></div>
        <div class="tape tape--right" aria-hidden="true"></div>

        <div class="card-copy">
            <h1 id="form-heading">Partner with us</h1>
            <p>
                We would love to have you be a part of making Hunt the Universe
                happen! Tell us a little about yourself and how you would like
                to get involved.
            </p>

            <a
                class="form-button"
                href={partnershipUrl}
                target="_blank"
                rel="noreferrer"
                aria-label="Open the partnership form (opens in a new tab)"
            >
                <span>Open the partnership form</span>
                <span class="arrow" aria-hidden="true">
                    ↗
                </span>
            </a>

            <p class="partner-note">
                <span aria-hidden="true">★</span>
                Thanks for helping make the hunt possible!
                <span aria-hidden="true">★</span>
            </p>
        </div>
    </section>

    <aside class="questions" aria-label="Partnership questions">
        <img
            src={magnifyingGlass.src}
            alt="A smiling magnifying glass"
            width={magnifyingGlass.width}
            height={magnifyingGlass.height}
            loading="lazy"
        />
        <p>
            Partnership puzzle?
            <br />
            <a href="mailto:HuntTheUniverse@gmail.com">Ask the Hunt Masters!</a>
        </p>
    </aside>

    <img
        class="bridge bridge--left"
        src={bridgeLeft.src}
        alt=""
        width={bridgeLeft.width}
        height={bridgeLeft.height}
        loading="lazy"
    />
    <img
        class="bridge bridge--right"
        src={bridgeRight.src}
        alt=""
        width={bridgeRight.width}
        height={bridgeRight.height}
        loading="lazy"
    />
</PageLayout>

<style>
    h1 {
        margin: 0;
        color: var(--color-blue);
        font-family: var(--font-hand);
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 900;
        letter-spacing: -0.05em;
        line-height: 0.95;
        text-wrap: balance;
        text-transform: uppercase;
    }

    .partnership-card {
        position: relative;
        z-index: 2;
        width: min(calc(100% - 1rem), 58rem);
        margin: clamp(2rem, 5vw, 8rem) auto 0;
        padding: clamp(2.75rem, 7vw, 5.5rem) clamp(1.5rem, 7vw, 5rem);
        border: 3px solid var(--color-ink);
        border-radius: 1.25rem 2.25rem 1.4rem 2rem;
        background:
            radial-gradient(
                circle at 10% 12%,
                rgb(253 3 182 / 10%),
                transparent 24%
            ),
            linear-gradient(rgb(22 37 216 / 7%) 1px, transparent 1px),
            rgb(255 255 255 / 96%);
        background-size:
            auto,
            100% 2rem,
            auto;
        box-shadow: 7px 9px 0 rgb(23 33 68 / 20%);
        transform: rotate(0.25deg);
    }

    .tape {
        position: absolute;
        top: -1.4rem;
        width: clamp(6rem, 13vw, 10rem);
        height: 2.8rem;
        background: rgb(169 231 255 / 88%);
        opacity: 0.92;
    }

    .tape--left {
        left: 7%;
        transform: rotate(-4deg);
    }

    .tape--right {
        right: 6%;
        background: rgb(253 3 182 / 35%);
        transform: rotate(5deg);
    }

    .card-copy {
        max-width: 43rem;
        margin-inline: auto;
        text-align: center;
    }

    .card-copy > p:not(.partner-note) {
        margin: 1.5rem auto 2rem;
        font-size: clamp(1rem, 1.6vw, 1.15rem);
        line-height: 1.65;
    }

    .form-button {
        display: flex;
        width: min(100%, 34rem);
        min-height: 6rem;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-inline: auto;
        padding: 1rem 1.4rem;
        border: 4px solid var(--color-ink);
        border-radius: 1rem;
        background: var(--color-pink);
        box-shadow: 6px 7px 0 var(--color-ink);
        color: white;
        font-family: var(--font-hand);
        font-size: clamp(1.35rem, 3.4vw, 2rem);
        font-weight: 900;
        line-height: 1;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            translate 150ms ease,
            box-shadow 150ms ease,
            filter 150ms ease;
        transform: rotate(-0.4deg);
    }

    .form-button:hover {
        filter: saturate(1.08) brightness(1.05);
        translate: 2px 2px;
        box-shadow: 4px 5px 0 var(--color-ink);
    }

    .form-button:active {
        translate: 6px 7px;
        box-shadow: 0 0 0 var(--color-ink);
    }

    .form-button:focus-visible {
        outline: 5px solid var(--color-blue);
        outline-offset: 5px;
    }

    .arrow {
        font-size: 1.5em;
        line-height: 0;
    }

    .partner-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        margin: 1.5rem 0 0;
        color: var(--color-violet);
        font-family: var(--font-hand);
        font-size: clamp(0.9rem, 1.6vw, 1.05rem);
        font-weight: 900;
        line-height: 1.3;
        text-transform: uppercase;
    }

    .partner-note span {
        color: var(--color-pink);
    }

    .questions {
        position: relative;
        z-index: 2;
        display: flex;
        width: min(calc(100% - 2rem), 42rem);
        align-items: center;
        gap: 1rem;
        margin: 2rem auto 0;
        padding: 1rem 1.4rem;
        border: 3px dashed var(--color-blue);
        border-radius: 1.4rem;
        background: rgb(255 255 255 / 78%);
        color: var(--color-ink);
        font-family: var(--font-hand);
        font-size: clamp(1rem, 2vw, 1.25rem);
        font-weight: 900;
        transform: rotate(0.6deg);
    }

    .questions img {
        width: clamp(4.5rem, 10vw, 6.5rem);
        height: auto;
    }

    .questions p {
        margin: 0;
        line-height: 1.35;
    }

    .questions a {
        color: var(--color-blue);
        font-weight: 900;
        text-decoration-color: var(--color-pink);
        text-decoration-thickness: 0.14em;
        text-underline-offset: 0.16em;
    }

    .questions a:hover {
        color: var(--color-pink);
    }

    .questions a:focus-visible {
        outline: 3px solid var(--color-pink);
        outline-offset: 3px;
    }

    .bridge {
        position: absolute;
        z-index: 1;
        bottom: 0;
        display: block;
        width: clamp(9rem, 20vw, 17rem);
        height: auto;
        pointer-events: none;
        user-select: none;
    }

    .bridge--left {
        left: 0;
    }

    .bridge--right {
        right: 0;
    }

    @media (max-width: 48rem) {
        .partnership-card {
            width: 100%;
            margin-top: 5rem;
            padding: 3.5rem 1.1rem 4.25rem;
        }

        .form-button {
            min-height: 5.5rem;
            padding-inline: 1rem;
        }

        .partner-note {
            align-items: flex-start;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .form-button {
            transition: none;
        }
    }
</style>
